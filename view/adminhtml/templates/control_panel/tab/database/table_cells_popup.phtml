<?php

/** @var $block \M2E\Core\Block\Adminhtml\ControlPanel\Tab\Database\Table\TableCellsPopup */

?>

<script>

    $$('#controlPanel_tabs_database_table_cells_popup .input_switcher').each(function (el) {
        el.observe('change', M2ECoreControlPanelDatabaseGridObj.switcherStateChange.bind(el));
    });

</script>

<div id="controlPanel_tabs_database_table_cells_popup">

    <h4>
        <?= /* @noEscape */ __('Table `%table_name`', ['table_name' => $block->getTableName()]); ?>
        <?php
        if ($block->isUpdateCellsMode()): ?>
            <span style="color: grey; font-style: italic; font-weight: lighter;">
                &nbsp;<?= /* @noEscape */ __('(%amount records)', ['amount' => count($block->getIds())]); ?>
            </span>
        <?php
        endif; ?>
    </h4>

    <form id="controlPanel_tabs_database_table_cells_popup_form">

        <?php
        if ($block->isUpdateCellsMode()): ?>
            <input type="hidden" name="ids" value="<?= /* @noEscape */ implode(',', $block->getIds()); ?>"/>
        <?php
        endif; ?>

        <table>
            <?php
            foreach ($block->tableModel->getColumns() as $column): ?>
                <?php
                if (strpos($column['extra'], 'increment') !== false) {
                    continue;
                } ?>

                <tr id="tr_column_id_<?= /* @noEscape */ $column['name']; ?>">
                    <td style="width: 350px; height: 23px;" title="<?= /* @noEscape */ $column['type']; ?>">
                        <?= /* @noEscape */ $column['name']; ?>
                    </td>
                    <td style="width: 25px;">
                        <input id="switcher_column_id_<?= /* @noEscape */ $column['name']; ?>" class="input_switcher" type="checkbox" name="cells[]" value="<?= /* @noEscape */ $column['name']; ?>"/>
                    </td>
                    <td>
                        <input id="input_column_id_<?= /* @noEscape */ $column['name']; ?>" name="value_<?= /* @noEscape */ $column['name']; ?>" type="text" size="37" disabled="disabled"/>
                    </td>
                </tr>

            <?php
            endforeach; ?>
        </table>

    </form>

</div>
